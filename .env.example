# PostgreSQL ulanish URL (asyncpg drayver)
DATABASE_URL=postgresql+asyncpg://yuk_user:yuk_password@localhost:5432/yuk_marketplace

# Redis URL (FSM storage va kesh uchun)
REDIS_URL=redis://localhost:6379

# True qo'yilsa SQLAlchemy so'rovlarni logga chiqaradi
DEBUG=false

# Adminlar (vergul bilan)
ADMIN_IDS=6445652739

# --- Kanal o'quvchi (Telethon) ---
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=
TELEGRAM_PHONE=+998900000000
CHANNEL_IDS=-1001234567890
LORRY_CHANNEL_IDS=-1001234567890

# Telethon sessiya fayli nomi (data/ ichida). ODATDA O'ZGARTIRILMAYDI.
# MUHIM: asosiy sessiya (telethon_session) FAQAT bitta mashinada — serverda
# ishlashi kerak. Lokal kompyuterda skript ishlatish uchun boshqa nom bering,
# aks holda Telegram auth key ni bekor qiladi (AuthKeyDuplicatedError) va
# yuklar bazasiga tushmay qoladi:
#     TELETHON_SESSION_NAME=diag_session python3 scripts/diag_reader.py
# TELETHON_SESSION_NAME=telethon_session

# conf >= shu qiymat -> yuk avtomatik ochiladi; pastda -> admin moderatsiyasiga
PARSER_AUTO_APPROVE_CONFIDENCE=0.85
